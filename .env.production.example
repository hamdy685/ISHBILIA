# انسخ هذا الملف إلى .env على خادم الإنتاج ولا تضعه داخل Git.
APP_NAME="Al-Ashbiliya Procurement Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
# Cloudflare/Nginx are the only reverse proxies in front of Laravel.
TRUSTED_PROXIES=*
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
CORS_ALLOWED_ORIGINS=https://your-domain.com
SANCTUM_STATEFUL_DOMAINS=your-domain.com
# SANCTUM_TOKEN_EXPIRATION=null (Permanent session - tokens do not expire)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=al_ashbiliya_procurement
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
SESSION_DRIVER=file
SESSION_LIFETIME=525600
SESSION_ENCRYPT=true
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=redis

# Required before production: create a Sentry project and set its DSN.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
VITE_APP_NAME="Al-Ashbiliya Procurement Management System"
VITE_API_BASE_URL=/api/v1

# Optional Web Push/FCM configuration. Leave empty to keep Web Push disabled safely.
# Use the Web app config from the same Firebase project and restrict the API key by domain.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

VITE_NOTIFICATIONS_STREAM_TIMEOUT=120

# Production browser security headers.
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
