# Application Configuration
APP_NAME="Al-Ashbiliya Procurement Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000

# Locale & Fallback
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=al_ashbiliya_procurement
DB_USERNAME=ashbiliya_app
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=prefer

# Session, Cache, Queue & Storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Cloudflare R2 Cloud Storage (for images, receipts & quote attachments)
# Set FILESYSTEM_DISK=r2 to make Cloudflare R2 the active storage disk
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://<custom-domain-or-r2-pub-url>
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# Frontend Environment Variables
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Excel Backup (configure after deployment)
DATABASE_EXCEL_BACKUP_ENABLED=true
DATABASE_EXCEL_BACKUP_DISK=local
DATABASE_EXCEL_BACKUP_DIRECTORY=backups/database
DATABASE_EXCEL_BACKUP_TABLES=
DATABASE_EXCEL_BACKUP_GOOGLE_ENABLED=false
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

